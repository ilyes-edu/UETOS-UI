# Copy to .streamlit/secrets.toml (locally) or paste into Streamlit Cloud → App settings → Secrets.
# Without this section the app uses a local SQLite file data/app.db (erased on each Streamlit Cloud restart).
[connections.db]
# Free external MySQL options: TiDB Serverless, Aiven MySQL, Railway ...
url = "mysql+pymysql://USER:PASSWORD@HOST:3306/timetable?charset=utf8mb4"
# TiDB Serverless requires SSL, e.g.:
# url = "mysql+pymysql://USER:PASSWORD@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/timetable?ssl_verify_cert=true&ssl_verify_identity=true"
